{
  "info": {
    "name": "TP Symfony - Missions 35 a 37",
    "description": "A importer dans Postman (Import) ou Insomnia (Import > From File). Lancer d'abord les requetes 'login' : elles enregistrent le token dans les variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "dummy_token", "value": "" }
  ],
  "item": [
    {
      "name": "Mission 35 - API locale (JWT)",
      "item": [
        {
          "name": "1. login_check (obtenir le token)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@a.com\",\"password\":\"1234\"}" },
            "url": "{{base}}/api/login_check"
          }
        },
        {
          "name": "2. GET ingredients sans token (401)",
          "request": { "method": "GET", "header": [{ "key": "Accept", "value": "application/ld+json" }], "url": "{{base}}/api/ingredients" }
        },
        {
          "name": "3. GET ingredients avec token",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "header": [{ "key": "Accept", "value": "application/ld+json" }],
            "url": "{{base}}/api/ingredients"
          }
        },
        {
          "name": "4. Filtre nom=ingr_c",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "header": [{ "key": "Accept", "value": "application/ld+json" }],
            "url": "{{base}}/api/ingredients?nom=ingr_c"
          }
        },
        {
          "name": "5. Filtre prix[gte]=100",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "header": [{ "key": "Accept", "value": "application/ld+json" }],
            "url": "{{base}}/api/ingredients?prix[gte]=100"
          }
        }
      ]
    },
    {
      "name": "Mission 37 - DummyJSON (API libre)",
      "item": [
        { "name": "1. Lister les utilisateurs", "request": { "method": "GET", "url": "https://dummyjson.com/users" } },
        { "name": "2. Lister les posts", "request": { "method": "GET", "url": "https://dummyjson.com/posts" } },
        {
          "name": "3. Creer un post",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\":\"Ma recette de crepes\",\"body\":\"Laisser reposer la pate.\",\"userId\":1}" },
            "url": "https://dummyjson.com/posts/add"
          }
        },
        {
          "name": "4. Creer un commentaire",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"body\":\"Super recette !\",\"postId\":1,\"userId\":1}" },
            "url": "https://dummyjson.com/comments/add"
          }
        },
        { "name": "5. Effacer un post", "request": { "method": "DELETE", "url": "https://dummyjson.com/posts/1" } },
        {
          "name": "6. Actualiser completement un post (PUT)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\":\"Titre remplace\",\"body\":\"Contenu remplace\",\"userId\":1}" },
            "url": "https://dummyjson.com/posts/1"
          }
        },
        {
          "name": "7. Actualiser partiellement un post (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"title\":\"Nouveau titre seulement\"}" },
            "url": "https://dummyjson.com/posts/1"
          }
        }
      ]
    },
    {
      "name": "Mission 37 - DummyJSON (API securisee JWT)",
      "item": [
        {
          "name": "1. login (compte de test emilys)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.collectionVariables.set('dummy_token', pm.response.json().accessToken);"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"username\":\"emilys\",\"password\":\"emilyspass\"}" },
            "url": "https://dummyjson.com/auth/login"
          }
        },
        {
          "name": "2. Posts avec le token",
          "request": {
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{dummy_token}}" }] },
            "url": "https://dummyjson.com/auth/posts"
          }
        },
        {
          "name": "3. Posts sans token (erreur attendue)",
          "request": { "method": "GET", "url": "https://dummyjson.com/auth/posts" }
        }
      ]
    }
  ]
}
