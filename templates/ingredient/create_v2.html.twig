{% extends 'base.html.twig' %}

{% block title %}Créer un ingrédient v2{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 2rem;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <h1>Créer un ingrédient v2</h1>
        {{ form_start(crea_form) }}
            {{ form_row(crea_form.nom) }}
            {{ form_row(crea_form.prix) }}
            {{ form_row(crea_form.save) }}
        {{ form_end(crea_form) }}
    </div>
{% endblock %}
