{% extends 'base.html.twig' %}

{% block title %}Ingrédients{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #ffffff;
            margin: 0;
            padding: 2rem;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }
        th, td {
            padding: 12px 15px;
            text-align: left;
        }
        th {
            background: #f0f0f0;
            font-weight: 600;
        }
        tr:nth-child(even) {
            background: #fafafa;
        }
        img {
            display: block;
            margin-bottom: 1rem;
        }
        a {
            color: #007bff;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        {% for message in app.flashes('danger') %}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                {{ message }}
            </div>
        {% endfor %}

        <div class="mb-3">
            {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                Connecté : {{ app.user.userIdentifier }} -
                <a href="{{ path('app_logout') }}">Se déconnecter</a>
            {% else %}
                <a href="{{ path('app_login') }}">Se connecter</a> -
                <a href="{{ path('app_register') }}">S'inscrire</a>
            {% endif %}
        </div>

        <p>Ingrédients et prix</p>
        <img id="ingredient-icon" src="{{ asset('images/ingredient-icon.svg') }}" alt="Icône ingrédient" width="64" height="64" style="cursor: pointer;">
        <p id="ingredient-message" style="display: none; color: #555; font-style: italic;">Vous avez cliqué sur l'icône des ingrédients !</p>

        <ul>
            {% for ingredient in ingredients %}
                <li>
                    Ingrédient {{ loop.index }} : <strong>{{ ingredient.nom }}</strong>, <strong>{{ ingredient.prix|number_format(2, ',', ' ') }} EUR</strong>
                </li>
            {% else %}
                <li>Aucun ingrédient trouvé.</li>
            {% endfor %}
        </ul>

        {% if is_granted('ROLE_USER') %}
        <a href="{{ path('ingredient.create_and_store_v3') }}" class="btn btn-primary mb-3">Créer un ingrédient</a>
        {% endif %}

        <table>
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Nom</th>
                    <th>Prix (EUR)</th>
                    <th>date de création</th>
                </tr>
            </thead>
            <tbody>
                {% for ingredient in ingredients %}
                <tr>
                    <td>{{ ingredient.id }}</td>
                    <td><a href="{{ path('ingredient.show_by_slug', {slug: ingredient.slug}) }}">{{ ingredient.nom }}</a></td>
                    <td>{{ ingredient.prix|number_format(2, ',', ' ') }}</td>
                    <td>{{ ingredient.createdAt|date('d/m/Y H:i') }}</td>
                    {% if is_granted('ROLE_ADMIN') %}
                    <td><a href="{{ path('ingredient.edit', {id: ingredient.id}) }}">Modifier</a></td>
                    <td>
                        <form method="POST" action="{{ path('ingredient.delete', {id: ingredient.id}) }}">
                            <input type="hidden" name="_method" value="DELETE">
                            <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                        </form>
                    </td>
                    {% endif %}
                </tr>
                {% else %}
                    <tr>
                        <td colspan="4">Aucun ingrédient trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
