{% extends 'base.html.twig' %}

{% block title %}Ingrédients > 100 EUR v4{% endblock %}

{% block stylesheets %}
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f5f5;
            margin: 0;
            padding: 2rem;
        }
        .container {
            max-width: 900px;
            margin: 0 auto;
        }
        ul {
            list-style: none;
            padding: 0;
            margin: 0 0 2rem 0;
        }
        li {
            background: #ffffff;
            padding: 12px 15px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            margin-bottom: 10px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }
        th, td {
            padding: 12px 15px;
            text-align: left;
        }
        th {
            background: #f0f0f0;
            font-weight: 600;
        }
        tr:nth-child(even) {
            background: #fafafa;
        }
        a {
            color: #007bff;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container">
        <h1>Ingrédients dont le prix est supérieur à 100 EUR v4</h1>

        <ul>
            {% for ingredient in ingredients %}
                <li>
                    Ingrédient {{ loop.index }} : <strong>{{ ingredient.nom }}</strong>, <strong>{{ ingredient.prix|number_format(2, ',', ' ') }} EUR</strong>
                </li>
            {% else %}
                <li>Aucun ingrédient trouvé.</li>
            {% endfor %}
        </ul>

        <table>
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Nom</th>
                    <th>Prix (EUR)</th>
                    <th>date de création</th>
                </tr>
            </thead>
            <tbody>
                {% for ingredient in ingredients %}
                    <tr>
                        <td>{{ ingredient.id }}</td>
                        <td>{{ ingredient.nom }}</td>
                        <td>{{ ingredient.prix|number_format(2, ',', ' ') }}</td>
                        <td>{{ ingredient.createdAt|date('d/m/Y H:i') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">Aucun ingrédient trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
