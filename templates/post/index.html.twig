{% extends 'base.html.twig' %}

{% block title %}Posts{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Les posts cuisine</h1>
        {% if texte %}<p class="text-muted">{{ texte }}</p>{% endif %}
        {% for post in posts %}
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">{{ post.title ?? '(sans titre)' }}</h5>
                    <p class="card-text">{{ post.content ?? '' }}</p>
                </div>
            </div>
        {% else %}
            <p>Aucun post.</p>
        {% endfor %}
    </div>
{% endblock %}
